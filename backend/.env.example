# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────
# Matches the `db` service in docker-compose.yml (exposed on host port 5433)
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5433/taskflow?schema=public

# ── Auth ────────────────────────────────────────────────
# Generate strong secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# ── Rate limiting (requests per minute per IP) ─────────
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=10

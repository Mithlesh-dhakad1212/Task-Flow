// TaskFlow data model.
// One User owns many Projects; one Project contains many Tasks.
// Ownership of a Task is derived through its Project (single source of truth).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Declaration order matters: Postgres sorts enums by declaration, so
/// ORDER BY priority yields LOW < MEDIUM < HIGH.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String    @db.VarChar(80)
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  projects     Project[]
  sessions     Session[]

  @@map("users")
}

/// One row per login. The refresh token presented by the client is
/// "<session id>.<secret>"; only a SHA-256 hash of the secret is stored and it
/// is rotated on every refresh. Access tokens carry the session id so that a
/// revoked session is rejected immediately (true server-side logout).
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @map("refresh_token_hash")
  /// Hash of the token that was just rotated out — accepted for a short grace
  /// window so that two tabs refreshing concurrently do not log the user out.
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(2000)
  color       String   @default("blue") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  // Every project query is scoped by owner; these cover the list sort orders.
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  // Trigram index for ILIKE '%term%' search (pg_trgm extension, see init migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "projects_name_trgm_idx")
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  title       String       @db.VarChar(200)
  description String       @default("") @db.VarChar(5000)
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  /// Calendar date (no time component): "due on" semantics, timezone-agnostic.
  dueDate     DateTime     @map("due_date") @db.Date
  /// Set when a task transitions to DONE, cleared when it leaves DONE.
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "tasks_title_trgm_idx")
  @@map("tasks")
}

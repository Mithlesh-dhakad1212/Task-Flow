# Where the browser sends API calls. Leave as /api: requests go to this app's
# own same-origin proxy (src/app/api/[...path]/route.ts), which keeps session
# cookies first-party even when the API is on a different domain.
NEXT_PUBLIC_API_URL=/api

# Server-side only, read at runtime: where the proxy forwards /api/* requests.
#   local dev:       http://localhost:4000
#   docker compose:  http://api:4000
#   Railway:         http://<api-service>.railway.internal:<port>  (or the API's public https URL)
API_PROXY_TARGET=http://localhost:4000

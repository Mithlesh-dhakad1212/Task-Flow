  "info": {
    "title": "TaskFlow API",
    "description": "REST API for the TaskFlow project-management app.\n\n**Authentication** — call `POST /api/auth/login` (or `register`). The browser receives httpOnly\ncookies, so \"Try it out\" works straight away from this page. API clients can instead send the\nreturned `accessToken` as `Authorization: Bearer <token>`.\n\nAll errors share one envelope: `{ statusCode, error, message, details?, path, timestamp, requestId }`.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tf_access"
      }
    },
    "schemas": {
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "email"
          },
          "messages": {
            "example": [
              "email must be an email"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "messages"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          },
          "path": {
            "type": "string",
            "example": "/api/projects"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-10-15T10:00:00.000Z"
          },
          "requestId": {
            "type": "string",
            "example": "9b2f6c1e-1f0d-4a8e-9a43-2b0d8f1a7c55"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "path",
          "timestamp",
          "requestId"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {

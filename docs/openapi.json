            "maxLength": 80
          },
          "email": {
            "type": "string",
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!",
            "minLength": 8,
            "maxLength": 72,
            "description": "At least 8 characters with at least one letter and one number"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {

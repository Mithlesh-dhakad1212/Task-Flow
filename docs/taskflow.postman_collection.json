      "item": [
        {
          "name": "Liveness + database readiness probe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Timezone",
                "value": "Asia/Kolkata",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ],
              "query": []
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds successfully', () => pm.expect(pm.response.code).to.be.below(300));"
                ]
              }
            }
          ]
        }
      ]

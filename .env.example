# Optional overrides for docker-compose.yml (copy to .env).
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
# Host port for Postgres (change if 5433 is already in use)
DB_PORT=5433
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Seed the demo account (demo@taskflow.dev / Password123!) on startup
SEED_DEMO=true
